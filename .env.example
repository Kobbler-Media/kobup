# Copy to .env and edit. Every variable here is consumed by docker-compose.yml
# (and docker-compose.dev.yml).
#   cp .env.example .env

# --- Admin account -----------------------------------------------------------
# Created on first boot only. Leave the password blank to have one generated
# and printed to the API logs.
ADMIN_EMAIL=admin@localhost
ADMIN_BOOTSTRAP_PASSWORD=

# --- URLs --------------------------------------------------------------------
# Public base URL of this service. It is embedded in the download links and
# pairing payloads sent to devices, so it must be reachable from them.
KOBUP_BASE_URL=http://localhost:8080

# Comma-separated CORS origins for the web UI. Empty = allow all.
# KOBUP_WEB_ORIGINS=http://localhost:5175

# --- Ports -------------------------------------------------------------------
KOBUP_API_PORT=8080
KOBUP_WEB_PORT=5175

# --- Storage -----------------------------------------------------------------
# Where the SQLite database and uploaded APKs live. Defaults to the named
# Docker volume `kobup_data`; set a host path (e.g. ./data) to bind-mount
# instead.
KOBUP_DATA=kobup_data

# --- Logging -----------------------------------------------------------------
RUST_LOG=info,kobup_service=info

# --- Reverse proxy -------------------------------------------------------------
# How many reverse proxies sit between a client and the API, for trusting
# X-Forwarded-For on login rate limiting. The bundled nginx is 1 (the
# default). If you also run this behind an outer reverse proxy (e.g.
# Nginx Proxy Manager, Caddy), set it to 2.
KOBUP_TRUSTED_PROXY_HOPS=1

# --- PIN pairing relay ----------------------------------------------------------
# Relay the CLI/Android PIN login goes through. Empty uses the public
# https://pin.biboop.com. Build kobup-android with -PpinServiceUrl=... and run
# the CLI with the same KOBUP_PIN_SERVICE_URL to match.
# KOBUP_PIN_SERVICE_URL=

# --- Optional: FCM push notifications ----------------------------------------
# Path INSIDE the container to a Firebase service account JSON. Mount the file
# in via the commented volume in docker-compose.yml.
# FCM_SERVICE_ACCOUNT_JSON=/secrets/fcm.json
# FCM_SERVICE_ACCOUNT_HOST_PATH=./fcm-service-account.json

# --- Optional: GitHub release ingestion --------------------------------------
# KOBUP_GITHUB_TOKEN=CHANGEME
# KOBUP_GITHUB_API_URL=https://api.github.com
# GITHUB_POLL_INTERVAL_SECS=3600

# --- Retention ---------------------------------------------------------------
# Max releases kept per project/channel; older ones are pruned hourly.
MAX_RELEASES_PER_CHANNEL=10
